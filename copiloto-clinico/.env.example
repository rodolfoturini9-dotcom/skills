# Defina estes valores no ambiente ou no arquivo .env do Docker Compose.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Recomendado quando acessado por outras máquinas; use segredo aleatório forte.
COPILOT_ACCESS_TOKEN=
# hash = índice local sem chamada externa; openai = embeddings treinados com cobrança da API.
RAG_EMBEDDINGS=hash
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# Opcional: somente leitura de MedicationRequest FHIR R4.
FHIR_BASE_URL=
FHIR_BEARER_TOKEN=
