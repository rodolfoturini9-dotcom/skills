{
  "name": "uti-adulto-netlify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/embed-pages.mjs",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.mjs && node --import tsx core-checks.mjs && node --import tsx ficha-history-checks.mjs && node --import tsx handoff-checks.mjs && node --import tsx prescricao-checks.mjs",
    "test:netlify": "node --import tsx --test tests/netlify-adapter.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy": "npx netlify deploy --build --prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@netlify/database": "^2.0.1",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "playwright-core": "^1.56.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
